@model IReadOnlyList<Project.Models.BookLoan>
@{ Layout = "_ReaderLayout"; }
@{
    ViewData["Title"] = "Phiếu mượn của tôi";
    var today = DateOnly.FromDateTime(DateTime.Today);
}
<div class="container py-4">
    <div class="mb-4">
        <h1 class="h3 mb-1 text-primary fw-bold">Phiếu mượn của tôi</h1>
        <p class="text-muted mb-0">Theo dõi hạn trả và gia hạn phiếu mượn còn hiệu lực.</p>
    </div>
    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
    <div class="card shadow-sm border-0"><div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Sách</th><th>Ngày mượn</th><th>Hạn trả</th><th>Số lần gia hạn</th><th>Thao tác</th></tr></thead>
            <tbody>
            @if (Model.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Bạn chưa có phiếu mượn nào.</td></tr> }
            @foreach (var loan in Model)
            {
                var renewalLimit = loan.ReaderAccount?.LibraryCard?.LibraryCardType?.MaxRenewals ?? 0;
                var isOpen = !loan.IsReturned;
                <tr>
                    <td>@loan.Book?.Title</td>
                    <td>@loan.LoanDate.ToString("dd/MM/yyyy")</td>
                    <td class="fw-semibold">@loan.DueDate.ToString("dd/MM/yyyy")</td>
                    <td>@loan.RenewalCount / @renewalLimit</td>
                    <td>
                        @if (isOpen && loan.DueDate >= today)
                        {
                            <form asp-action="Renew" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@loan.Id" />
                                <button class="btn btn-sm btn-outline-primary" type="submit">Gia hạn</button>
                            </form>
                        }
                        else if (!isOpen) { <span class="badge bg-secondary">Đã đóng</span> }
                        else { <span class="badge bg-danger">Đã quá hạn</span> }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div></div>
</div>
