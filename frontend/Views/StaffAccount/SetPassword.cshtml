@model Project.Models.StaffSetPasswordViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đặt mật khẩu tài khoản";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <title>@ViewData["Title"] - Thư viện</title>
    <partial name="_HeadAssets" />
</head>
<body class="login-page">
    <main class="login-wrap reader-login-wrap">
        <header class="login-brand">
            <span class="login-brand-pill"><span class="login-brand-icon">▤</span> HỆ THỐNG QUẢN LÝ THƯ VIỆN</span>
            <div class="login-brand-sub">KÍCH HOẠT TÀI KHOẢN NHÂN SỰ</div>
        </header>
        <section class="login-card reader-login-card">
            <div class="login-card-heading">
                <div><h1>Đặt mật khẩu</h1><p>Tạo mật khẩu để bắt đầu sử dụng tài khoản thư viện.</p></div>
            </div>

            @if (ViewBag.Success == true)
            {
                <div class="alert alert-success mt-4" role="status">Mật khẩu đã được thiết lập. Bạn có thể đăng nhập ngay.</div>
                <a asp-controller="@ViewBag.LoginController" asp-action="Login" class="login-submit text-decoration-none">Đến trang đăng nhập <span aria-hidden="true">→</span></a>
            }
            else if (ViewBag.InvalidToken == true)
            {
                <div class="alert alert-danger mt-4" role="alert">Liên kết không hợp lệ, đã hết hạn (sau 24 giờ) hoặc đã được sử dụng. Vui lòng liên hệ Quản trị hệ thống để nhận liên kết mới.</div>
            }
            else
            {
                <form asp-action="SetPassword" method="post">
                    <input asp-for="Token" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="login-validation" role="alert"></div>
                    <div class="login-field">
                        <div class="login-label-row"><label asp-for="Password"></label><span>ÍT NHẤT 8 KÝ TỰ, CÓ CHỮ VÀ SỐ</span></div>
                        <div class="login-input-wrap"><span aria-hidden="true">⚿</span><input asp-for="Password" class="form-control" autocomplete="new-password" autofocus /></div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="login-field">
                        <div class="login-label-row"><label asp-for="ConfirmPassword"></label></div>
                        <div class="login-input-wrap"><span aria-hidden="true">⚿</span><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /></div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                    <button type="submit" class="login-submit reader-login-submit">Lưu mật khẩu <span aria-hidden="true">→</span></button>
                </form>
            }
        </section>
        <footer class="login-footer reader-login-footer"><span>© 2026 Thư viện · Cổng nhân sự</span></footer>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
