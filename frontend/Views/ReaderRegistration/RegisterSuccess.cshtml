@{
    Layout = "_ReaderLayout";
    ViewData["Title"] = "Đăng ký thành công";
}

<div class="rd-narrow" style="width: min(600px, 100%)">
    <div class="rd-card">
        <div class="rd-card-body rd-status">
            <div class="rd-status-icon is-success"><i class="bi bi-check2-circle"></i></div>
            <h1>@(ViewBag.SuccessMessage ?? "Đăng ký thành công")</h1>
            <p class="rd-lead">
                Trạng thái tài khoản: <span class="rd-pill is-pending"><i class="bi bi-hourglass-split"></i> @ViewBag.AccountStatus</span>
            </p>

            @if (ViewBag.VerificationEmail is string verificationEmail)
            {
                <div class="text-start" id="verifyEmailNotice" role="status">
                    @if (ViewBag.VerificationEmailSent is true)
                    {
                        <div class="alert alert-info d-flex gap-2 align-items-start">
                            <i class="bi bi-envelope-check fs-5"></i>
                            <div>Chúng tôi đã gửi liên kết xác nhận tới <strong>@verificationEmail</strong>. Hãy mở email và bấm <strong>"Xác nhận email"</strong> trong vòng 24 giờ. Bạn chỉ đăng nhập được sau khi đã xác nhận.</div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning d-flex gap-2 align-items-start">
                            <i class="bi bi-exclamation-triangle fs-5"></i>
                            <div>Hệ thống chưa gửi được email xác nhận tới <strong>@verificationEmail</strong>. Bạn có thể thử gửi lại sau ít phút.</div>
                        </div>
                    }
                    @if (ViewBag.DevConfirmLink is string devLink)
                    {
                        <div class="rd-dev-link"><strong>Môi trường phát triển (chưa cấu hình SMTP):</strong> <a href="@devLink">@devLink</a></div>
                    }
                </div>
            }

            <ol class="rd-steps my-4">
                <li class="is-done"><strong>Đã tạo tài khoản</strong><span>Thông tin của bạn đã được lưu.</span></li>
                <li><strong>Xác nhận email</strong><span>Mở hộp thư và bấm liên kết xác nhận.</span></li>
                <li><strong>Nhận thẻ &amp; bắt đầu mượn sách</strong><span>@ViewBag.Instruction</span></li>
            </ol>

            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a asp-action="Login" class="btn btn-primary"><i class="bi bi-box-arrow-in-right"></i> Đăng nhập bạn đọc</a>
                <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-search"></i> Tra cứu sách</a>
            </div>

            @if (ViewBag.VerificationEmail is string emailForResend)
            {
                <div class="rd-note">
                    <i class="bi bi-lightbulb me-1"></i> Không thấy email? Kiểm tra mục <strong>Thư rác / Quảng cáo</strong> hoặc
                    <a asp-action="ResendConfirmation" asp-route-email="@emailForResend">gửi lại email xác nhận</a>.
                    Muốn đăng ký thêm? <a asp-action="Register">Đăng ký tài khoản khác</a>.
                </div>
            }
        </div>
    </div>
</div>
