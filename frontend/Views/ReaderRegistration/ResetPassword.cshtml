@model Project.Models.ResetPasswordViewModel
@{
    Layout = "_ReaderLayout";
    ViewData["Title"] = "Tạo mật khẩu mới";
}
<div class="rd-narrow">
    <div class="rd-card">
        <div class="rd-card-body">
            @if (ViewBag.Success is string success)
            {
                <div class="rd-status">
                    <div class="rd-status-icon is-success"><i class="bi bi-shield-check"></i></div>
                    <h1>Đã đổi mật khẩu</h1>
                    <p class="rd-lead" role="status">@success</p>
                    <a asp-action="Login" class="btn btn-primary"><i class="bi bi-box-arrow-in-right"></i> Đăng nhập</a>
                </div>
            }
            else if (ViewBag.InvalidToken == true)
            {
                <div class="rd-status">
                    <div class="rd-status-icon is-danger"><i class="bi bi-link-45deg"></i></div>
                    <h1>Liên kết không dùng được</h1>
                    <p class="rd-lead" role="alert">Liên kết không hợp lệ, đã hết hạn hoặc đã được sử dụng. Vui lòng yêu cầu liên kết mới.</p>
                    <a asp-action="ForgotPassword" class="btn btn-primary"><i class="bi bi-arrow-repeat"></i> Yêu cầu liên kết mới</a>
                </div>
            }
            else
            {
                <div class="rd-status">
                    <div class="rd-status-icon is-gold"><i class="bi bi-shield-lock"></i></div>
                    <h1>Tạo mật khẩu mới</h1>
                    <p class="rd-lead">Mật khẩu cần ít nhất 8 ký tự, gồm cả chữ và số.</p>
                </div>
                <form asp-action="ResetPassword" method="post" class="rd-form">
                    <input asp-for="Token" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <div class="login-input-group">
                            <i class="bi bi-lock login-input-icon" aria-hidden="true"></i>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                            <button type="button" class="login-password-toggle" data-password-toggle="Password" aria-label="Hiện mật khẩu" aria-pressed="false" tabindex="-1"><i class="bi bi-eye"></i></button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <div class="login-input-group">
                            <i class="bi bi-shield-check login-input-icon" aria-hidden="true"></i>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <button type="button" class="login-password-toggle" data-password-toggle="ConfirmPassword" aria-label="Hiện mật khẩu" aria-pressed="false" tabindex="-1"><i class="bi bi-eye"></i></button>
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                    <button type="submit" class="login-submit"><span>Đổi mật khẩu</span><i class="bi bi-check2 ms-1"></i></button>
                </form>
            }
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
