@model string
@{
    ViewData["Title"] = "Không thể mở phiếu mượn";
}
<div class="container py-5" style="max-width: 800px">
    <div class="alert alert-warning" role="alert">
        <h1 class="h5">Không thể mở phiếu mượn</h1>
        <p class="mb-0">@Model</p>
    </div>
    <a asp-controller="HoldPickup" asp-action="Index" class="btn btn-outline-primary">Quay lại đơn chờ nhận</a>
</div>
