@model Project.Models.CatalogBookViewModel
@{
    ViewData["Title"] = "Biên mục sách mới";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3 mb-3 text-center text-primary font-weight-bold">Biên mục sách mới</h1>
                <p class="text-muted text-center mb-4">Nhập thông tin biên mục sách vào hệ thống thư viện</p>

                <form asp-action="Create" method="post" id="catalogBookForm" novalidate>
                    @Html.AntiForgeryToken()
                    @if (Model.DuplicateTitleMatches.Count > 0)
                    {
                        <div class="alert alert-warning" role="alert" id="duplicateTitleWarning">
                            <h2 class="h6 fw-bold mb-2">Cảnh báo: nhan đề đã tồn tại</h2>
                            <p class="mb-2">@Project.Models.CatalogBookRules.DuplicateTitleMessage Đầu sách mới <strong>chưa được lưu</strong>.</p>
                            <ul class="mb-3 ps-3">
                                @foreach (var match in Model.DuplicateTitleMatches)
                                {
                                    <li class="mb-1">
                                        <a asp-action="Details" asp-route-id="@match.Id" target="_blank" rel="noopener" class="fw-semibold">@match.Title</a>
                                        @if (!string.IsNullOrWhiteSpace(match.Subtitle))
                                        {
                                            <span>: @match.Subtitle</span>
                                        }
                                        <div class="small text-muted">
                                            Tác giả: @(string.IsNullOrWhiteSpace(match.Authors) ? "-" : match.Authors)
                                            · ISBN: @(match.Isbn ?? "-")
                                            · Năm XB: @(match.PublicationYear?.ToString() ?? "-")
                                        </div>
                                    </li>
                                }
                            </ul>
                            <div class="d-flex flex-wrap gap-2">
                                <button type="submit" name="ConfirmedDuplicateTitle" value="@Model.Title" class="btn btn-warning">Xác nhận tiếp tục lưu</button>
                                <button type="button" class="btn btn-outline-secondary" id="cancelDuplicateTitle">Hủy</button>
                            </div>
                        </div>
                        <script>
                            document.getElementById('cancelDuplicateTitle').addEventListener('click', () => {
                                document.getElementById('duplicateTitleWarning').remove();
                                document.getElementById('Title').focus();
                            });
                        </script>
                    }
                    <partial name="_BookForm" model="Model" />

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1 py-2" disabled="@(Model.ActiveCategories.Count == 0)">Lưu sách</button>
                        <a asp-action="Index" class="btn btn-outline-secondary py-2">Quay lại danh sách</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
