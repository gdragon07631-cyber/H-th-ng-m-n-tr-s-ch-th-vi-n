@model IReadOnlyList<Project.Models.Book>
@{
    ViewData["Title"] = "Danh mục sách";
    var copyCounts = ViewData["CopyCounts"] as IReadOnlyDictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1 text-primary font-weight-bold">Danh mục Sách</h1>
            <p class="text-muted mb-0">Danh sách các đầu sách đã được biên mục trong hệ thống thư viện</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                + Biên mục sách mới
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0 fw-semibold text-secondary">Danh sách Sách đã biên mục</h2>
            <span class="badge bg-primary rounded-pill">Tổng số: @Model.Count</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="booksTable">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="width: 60px;" class="text-center">STT</th>
                            <th scope="col" style="width: 90px;" class="text-center">Bìa</th>
                            <th scope="col">Nhan đề</th>
                            <th scope="col">ISBN</th>
                            <th scope="col">Tác giả</th>
                            <th scope="col">Nhà xuất bản</th>
                            <th scope="col" class="text-center">Năm XB</th>
                            <th scope="col">Thể loại</th>
                            <th scope="col" class="text-center">Số trang</th>
                            <th scope="col" style="width: 140px;" class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Count == 0)
                        {
                            <tr>
                                <td colspan="10" class="text-center py-4 text-muted">
                                    Chưa có cuốn sách nào được biên mục. Hãy nhấn <strong>Biên mục sách mới</strong> để thêm.
                                </td>
                            </tr>
                        }
                        else
                        {
                            var index = 1;
                            foreach (var book in Model)
                            {
                                <tr>
                                    <td class="text-center text-muted">@index</td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@book.Id" aria-label="Mở chi tiết @book.Title">
                                            <img src="@Project.Models.BookCoverPresentation.ForList(book)"
                                                 alt="Bìa sách @book.Title" class="book-cover-thumbnail" loading="lazy" />
                                        </a>
                                    </td>
                                    <td class="fw-medium text-dark">
                                        <a asp-action="Details" asp-route-id="@book.Id" class="text-decoration-none">
                                            @book.Title
                                        </a>
                                        @if (!string.IsNullOrWhiteSpace(book.Subtitle))
                                        {
                                            <div class="small text-muted">@book.Subtitle</div>
                                        }
                                        @if (copyCounts.GetValueOrDefault(book.Id) == 0)
                                        {
                                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle mt-1" data-status="no-copies">@Project.Models.BookCatalogStatus.NoCopies</span>
                                        }
                                    </td>
                                    <td class="text-muted small">@(string.IsNullOrWhiteSpace(book.Isbn) ? "-" : book.Isbn)</td>
                                    <td>
                                        @foreach (var author in Project.Models.BookAuthorList.For(book))
                                        {
                                            <div>
                                                <span class="fw-semibold">@author.Name</span>
                                                @if (author.Status == Project.Models.AuthorStatus.Inactive)
                                                {
                                                    <span class="badge bg-secondary ms-1 small">Ngừng sử dụng</span>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td>@(string.IsNullOrWhiteSpace(book.Publisher) ? "-" : book.Publisher)</td>
                                    <td class="text-center">@(book.PublicationYear?.ToString() ?? "-")</td>
                                    <td>@(book.Category == null ? "-" : book.Category.Parent == null ? book.Category.Name : $"{book.Category.Parent.Name} > {book.Category.Name}")</td>
                                    <td class="text-center">@(book.PageCount?.ToString() ?? "-")</td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@book.Id" class="btn btn-sm btn-outline-primary">
                                            Chi tiết
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@book.Id" class="btn btn-sm btn-outline-secondary mt-1">
                                            Sửa
                                        </a>
                                    </td>
                                </tr>
                                index++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
