@model Project.Models.WarehouseIndexViewModel
@{
    ViewData["Title"] = "Quản lý kho sách";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1 text-primary fw-bold">Danh sách Kho sách</h1>
            <p class="text-muted mb-0">Khai báo và quản lý các kho lưu trữ trong thư viện</p>
        </div>
        <div>
            <a asp-controller="Shelf" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-bookshelf"></i> Xem tất cả kệ sách
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Thành công!</strong> @success
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Lỗi:</strong> @error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Card Thêm Kho -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
            <h2 class="h5 mb-0 text-dark fw-semibold">Khai báo Kho sách mới</h2>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <div class="col-md-3">
                    <label class="form-label fw-bold" for="Code">Mã kho <span class="text-danger">*</span></label>
                    <input class="form-control" asp-for="NewWarehouse.Code" name="Code" placeholder="VD: KHO-A, KHO-CHINH" maxlength="50" required />
                    <small class="text-muted">Mã duy nhất trong toàn hệ thống</small>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold" for="Name">Tên kho <span class="text-danger">*</span></label>
                    <input class="form-control" asp-for="NewWarehouse.Name" name="Name" placeholder="VD: Kho sách Tổng hợp tầng 1" maxlength="150" required />
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="Address">Địa chỉ / Vị trí</label>
                    <input class="form-control" asp-for="NewWarehouse.Address" name="Address" placeholder="VD: Tòa nhà A - Tầng 2 - Phòng 204" maxlength="500" />
                </div>
                <div class="col-md-10">
                    <label class="form-label" for="Description">Mô tả</label>
                    <input class="form-control" asp-for="NewWarehouse.Description" name="Description" placeholder="Ghi chú thêm về kho sách (không bắt buộc)..." maxlength="500" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100" type="submit">
                        <i class="bi bi-plus-lg"></i> Thêm kho
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Danh sách Kho -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0 fw-semibold">Danh sách các kho hiện có</h2>
            <span class="badge bg-primary rounded-pill fs-6">@Model.Warehouses.Count kho</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 130px;">Mã kho</th>
                        <th>Tên kho</th>
                        <th>Vị trí / Mô tả</th>
                        <th style="width: 110px;" class="text-center">Số kệ</th>
                        <th style="width: 130px;" class="text-center">Trạng thái</th>
                        <th style="width: 260px;" class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Warehouses.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">Chưa có kho sách nào. Hãy thêm kho đầu tiên phía trên.</td>
                    </tr>
                }
                @foreach (var warehouse in Model.Warehouses)
                {
                    <tr>
                        <td>
                            <span class="badge bg-dark font-monospace fs-6">@warehouse.Code</span>
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@warehouse.Id" class="fw-bold text-decoration-none text-primary">
                                @warehouse.Name
                            </a>
                        </td>
                        <td>
                            <div>@(warehouse.Address ?? "—")</div>
                            @if (!string.IsNullOrEmpty(warehouse.Description))
                            {
                                <small class="text-muted">@warehouse.Description</small>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="Details" asp-route-id="@warehouse.Id" class="badge bg-info text-dark text-decoration-none">
                                @warehouse.Shelves.Count kệ sách
                            </a>
                        </td>
                        <td class="text-center">
                            <span class="badge @(warehouse.Status == Project.Models.WarehouseStatus.Active ? "bg-success" : "bg-secondary")">
                                @warehouse.Status
                            </span>
                        </td>
                        <td class="text-end pe-3 text-nowrap">
                            <a asp-action="Details" asp-route-id="@warehouse.Id" class="btn btn-sm btn-outline-info" title="Xem chi tiết & Quản lý kệ">
                                Chi tiết & Kệ
                            </a>

                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editWarehouseModal-@warehouse.Id" title="Sửa thông tin kho">
                                Sửa
                            </button>

                            @if (warehouse.Status == Project.Models.WarehouseStatus.Active)
                            {
                                <form asp-action="Deactivate" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn chuyển kho \'@warehouse.Name\' sang ngừng sử dụng?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@warehouse.Id" />
                                    <button class="btn btn-sm btn-outline-warning" type="submit" title="Ngừng sử dụng">
                                        Khóa
                                    </button>
                                </form>
                            }

                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa kho \'@warehouse.Name\'? Thao tác sẽ bị chặn nếu kho vẫn còn kệ sách.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@warehouse.Id" />
                                <button class="btn btn-sm btn-outline-danger" type="submit" title="Xóa kho">
                                    Xóa
                                </button>
                            </form>
                        </td>
                    </tr>

                    <!-- Modal Sửa Kho -->
                    <div class="modal fade" id="editWarehouseModal-@warehouse.Id" tabindex="-1" aria-labelledby="editWarehouseLabel-@warehouse.Id" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form asp-action="Edit" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Id" value="@warehouse.Id" />
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="editWarehouseLabel-@warehouse.Id">Sửa thông tin Kho sách</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body text-start">
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Mã kho <span class="text-danger">*</span></label>
                                            <input class="form-control" name="Code" value="@warehouse.Code" maxlength="50" required />
                                            <small class="text-muted">Mã kho là duy nhất trong toàn hệ thống.</small>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Tên kho <span class="text-danger">*</span></label>
                                            <input class="form-control" name="Name" value="@warehouse.Name" maxlength="150" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Địa chỉ / Vị trí</label>
                                            <input class="form-control" name="Address" value="@warehouse.Address" maxlength="500" />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Mô tả</label>
                                            <textarea class="form-control" name="Description" rows="2" maxlength="500">@warehouse.Description</textarea>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Trạng thái</label>
                                            <select class="form-select" name="Status">
                                                <option value="@Project.Models.WarehouseStatus.Active" selected="@(warehouse.Status == Project.Models.WarehouseStatus.Active)">@Project.Models.WarehouseStatus.Active</option>
                                                <option value="@Project.Models.WarehouseStatus.Inactive" selected="@(warehouse.Status == Project.Models.WarehouseStatus.Inactive)">@Project.Models.WarehouseStatus.Inactive</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
