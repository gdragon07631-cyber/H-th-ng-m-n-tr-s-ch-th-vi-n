@model Project.Models.HoldPickupItemViewModel
@{
    ViewData["Title"] = "Chi tiết đơn đặt giữ";
}

<div class="container py-4" style="max-width: 900px">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h1 class="h3 mb-1">Chi tiết đơn đặt giữ #@Model.HoldId</h1>
            <div class="text-muted">Kiểm tra thẻ bạn đọc trước khi tạo phiếu mượn.</div>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
    </div>

    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }
    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success" role="alert">@success</div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-4">Mã đơn đặt giữ</dt><dd class="col-sm-8">#@Model.HoldId</dd>
                <dt class="col-sm-4">Trạng thái</dt><dd class="col-sm-8">@Model.Status</dd>
                <dt class="col-sm-4">Bạn đọc</dt><dd class="col-sm-8">@Model.ReaderName (ID @Model.ReaderAccountId)</dd>
                <dt class="col-sm-4">Mã thẻ đã đăng ký</dt><dd class="col-sm-8"><strong>@(string.IsNullOrWhiteSpace(Model.LibraryCardCode) ? "Chưa có thẻ thư viện" : Model.LibraryCardCode)</strong></dd>
                <dt class="col-sm-4">Sách</dt><dd class="col-sm-8">@Model.BookTitle @if (!string.IsNullOrWhiteSpace(Model.Isbn)) { <span class="text-muted">(ISBN @Model.Isbn)</span> }</dd>
                <dt class="col-sm-4">Bản sao đã giữ</dt><dd class="col-sm-8">ID @Model.BookCopyId · <span class="font-monospace">@Model.CopyBarcode</span></dd>
                <dt class="col-sm-4">Ngày đặt</dt><dd class="col-sm-8">@Model.HeldAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                <dt class="col-sm-4">Hạn nhận</dt><dd class="col-sm-8">@Model.PickupDeadlineText</dd>
            </dl>
        </div>
    </div>

    @if (Model.CanConfirm)
    {
        <div class="card shadow-sm">
            <div class="card-header fw-semibold">Xác nhận nhận sách và tạo phiếu mượn</div>
            <div class="card-body">
                <form asp-action="Confirm" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="HoldId" value="@Model.HoldId" />
                    <div class="mb-3">
                        <label for="LibraryCardCode" class="form-label">Nhập mã thẻ bạn đọc để đối chiếu</label>
                        <input id="LibraryCardCode" name="LibraryCardCode" class="form-control" maxlength="32" required autocomplete="off" />
                    </div>
                    <button type="submit" class="btn btn-primary">Xác nhận và tạo phiếu mượn</button>
                </form>
            </div>
        </div>
    }
</div>
