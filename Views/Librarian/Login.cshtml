@model Project.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập thủ thư";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Thư viện</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
    <main class="login-wrap reader-login-wrap">
        <header class="login-brand">
            <span class="login-brand-pill"><span class="login-brand-icon">▤</span> HỆ THỐNG QUẢN LÝ THƯ VIỆN</span>
            <div class="login-brand-sub">CỔNG NGHIỆP VỤ DÀNH CHO THỦ THƯ</div>
        </header>
        <section class="login-card reader-login-card">
            <div class="login-card-heading">
                <div><h1>Đăng nhập thủ thư</h1><p>Dùng tài khoản được cấp riêng với vai trò Thủ thư.</p></div>
                <span class="login-version"><i></i> NHÂN SỰ</span>
            </div>
            <nav class="login-role-switch" aria-label="Chọn loại đăng nhập">
                <a class="selected" aria-current="page" asp-controller="Librarian" asp-action="Login"><span>✓</span><span><strong>Thủ thư</strong><small>Duyệt hồ sơ bạn đọc</small></span></a>
                <a asp-controller="Account" asp-action="Login"><span>⚙</span><span><strong>Quản trị viên</strong><small>Quản trị hệ thống</small></span></a>
                <a asp-controller="ReaderRegistration" asp-action="Login"><span>♙</span><span><strong>Bạn đọc</strong><small>Đăng nhập thư viện</small></span></a>
            </nav>
            <div asp-validation-summary="ModelOnly" class="login-validation" role="alert"></div>
            <form asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <div class="login-field">
                    <div class="login-label-row"><label asp-for="Email">Email thủ thư</label><span>VAI TRÒ: THỦ THƯ</span></div>
                    <div class="login-input-wrap"><span aria-hidden="true">✉</span><input asp-for="Email" class="form-control" placeholder="thuthu@thuvien.edu.vn" autocomplete="username" autofocus /></div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
                <div class="login-field">
                    <div class="login-label-row"><label asp-for="Password">Mật khẩu</label><span>BẢO MẬT</span></div>
                    <div class="login-input-wrap"><span aria-hidden="true">⚿</span><input asp-for="Password" class="form-control" placeholder="Mật khẩu của bạn" autocomplete="current-password" /></div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <button type="submit" class="login-submit reader-login-submit">Đăng nhập thủ thư <span aria-hidden="true">→</span></button>
            </form>
            <div class="login-help"><span class="login-help-icon">i</span><span>Tài khoản quản trị viên và bạn đọc không đăng nhập được tại cổng thủ thư.</span></div>
        </section>
        <footer class="login-footer reader-login-footer"><span>© 2026 Thư viện · Cổng nhân sự</span><a asp-controller="Account" asp-action="Login">Đăng nhập quản trị hệ thống</a></footer>
    </main>
</body>
</html>
