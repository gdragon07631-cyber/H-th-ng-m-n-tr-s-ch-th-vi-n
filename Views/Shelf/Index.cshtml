@model Project.Models.ShelfIndexViewModel
@{
    ViewData["Title"] = "Quản lý kệ sách";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1 text-primary fw-bold">Danh mục Kệ sách</h1>
            <p class="text-muted mb-0">Quản lý và bố trí các kệ sách theo từng kho lưu trữ</p>
        </div>
        <div>
            <a asp-controller="Warehouse" asp-action="Index" class="btn btn-outline-primary">
                <i class="bi bi-building"></i> Quản lý danh sách kho
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Thành công!</strong> @success
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Lỗi:</strong> @error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Form Thêm Kệ Mới -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
            <h2 class="h5 mb-0 fw-semibold text-dark">Khai báo Kệ sách mới</h2>
        </div>
        <div class="card-body">
            @if (Model.Warehouses.Count == 0)
            {
                <div class="alert alert-warning mb-0">
                    Chưa có kho sách nào trong hệ thống. Vui lòng <a asp-controller="Warehouse" asp-action="Index" class="alert-link">tạo kho sách trước</a> khi khai báo kệ.
                </div>
            }
            else
            {
                <form asp-action="Create" method="post" class="row g-3">
                    @Html.AntiForgeryToken()
                    <div class="col-md-3">
                        <label class="form-label fw-bold" for="WarehouseSelect">Kho trực thuộc <span class="text-danger">*</span></label>
                        <select class="form-select" id="WarehouseSelect" name="WarehouseId" required>
                            @foreach (var wh in Model.Warehouses)
                            {
                                <option value="@wh.Id" selected="@(Model.NewShelf.WarehouseId == wh.Id)">
                                    @wh.Name (@wh.Code)
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold" for="NewShelfCode">Mã kệ <span class="text-danger">*</span></label>
                        <input class="form-control" id="NewShelfCode" name="Code" placeholder="VD: KE-01" maxlength="50" required />
                        <small class="text-muted">Duy nhất theo kho</small>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold" for="NewShelfName">Tên kệ <span class="text-danger">*</span></label>
                        <input class="form-control" id="NewShelfName" name="Name" placeholder="VD: Kệ Giáo trình Đại cương" maxlength="150" required />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="NewShelfDesc">Mô tả</label>
                        <input class="form-control" id="NewShelfDesc" name="Description" placeholder="Ghi chú kệ..." maxlength="500" />
                    </div>
                    <div class="col-12 d-flex justify-content-end">
                        <button class="btn btn-primary" type="submit">
                            <i class="bi bi-plus-lg"></i> Thêm kệ mới
                        </button>
                    </div>
                </form>
            }
        </div>
    </div>

    <!-- Bộ lọc theo kho và Danh sách kệ -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
            <div class="d-flex align-items-center gap-2">
                <h2 class="h5 mb-0 fw-semibold">Danh sách Kệ sách</h2>
                <span class="badge bg-primary rounded-pill fs-6">@Model.Shelves.Count kệ</span>
            </div>
            <!-- Bộ lọc theo Kho -->
            <form method="get" class="d-flex align-items-center gap-2">
                <label class="text-muted small text-nowrap" for="filterWarehouse">Lọc theo kho:</label>
                <select class="form-select form-select-sm" id="filterWarehouse" name="warehouseId" onchange="this.form.submit()">
                    <option value="">-- Tất cả các kho --</option>
                    @foreach (var wh in Model.Warehouses)
                    {
                        <option value="@wh.Id" selected="@(Model.SelectedWarehouseId == wh.Id)">
                            @wh.Name (@wh.Code)
                        </option>
                    }
                </select>
                @if (Model.SelectedWarehouseId.HasValue)
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary text-nowrap">Bỏ lọc</a>
                }
            </form>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 130px;">Mã kệ</th>
                        <th>Tên kệ</th>
                        <th>Kho trực thuộc</th>
                        <th>Mô tả</th>
                        <th style="width: 120px;" class="text-center">Trạng thái</th>
                        <th style="width: 180px;" class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Shelves.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            Chưa có kệ sách nào@(Model.SelectedWarehouseId.HasValue ? " trong kho này" : "").
                        </td>
                    </tr>
                }
                @foreach (var shelf in Model.Shelves)
                {
                    <tr>
                        <td>
                            <span class="badge bg-primary font-monospace fs-6">@shelf.Code</span>
                        </td>
                        <td class="fw-bold">@shelf.Name</td>
                        <td>
                            <a asp-controller="Warehouse" asp-action="Details" asp-route-id="@shelf.WarehouseId" class="text-decoration-none fw-semibold">
                                @(shelf.Warehouse?.Name ?? $"Kho #{shelf.WarehouseId}")
                            </a>
                            <small class="text-muted d-block">Mã kho: @(shelf.Warehouse?.Code ?? "—")</small>
                        </td>
                        <td>@(shelf.Description ?? "—")</td>
                        <td class="text-center">
                            <span class="badge @(shelf.Status == Project.Models.ShelfStatus.Active ? "bg-success" : "bg-secondary")">
                                @shelf.Status
                            </span>
                        </td>
                        <td class="text-end pe-3 text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editModal-@shelf.Id">
                                Sửa
                            </button>

                            <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa kệ sách \'@shelf.Name\' (Mã: @shelf.Code)?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@shelf.Id" />
                                <input type="hidden" name="warehouseId" value="@Model.SelectedWarehouseId" />
                                <button class="btn btn-sm btn-outline-danger" type="submit">
                                    Xóa
                                </button>
                            </form>
                        </td>
                    </tr>

                    <!-- Modal Sửa Kệ -->
                    <div class="modal fade" id="editModal-@shelf.Id" tabindex="-1" aria-labelledby="editModalLabel-@shelf.Id" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form asp-action="Edit" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Id" value="@shelf.Id" />
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="editModalLabel-@shelf.Id">Sửa Kệ sách</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body text-start">
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Kho trực thuộc <span class="text-danger">*</span></label>
                                            <select class="form-select" name="WarehouseId" required>
                                                @foreach (var wh in Model.Warehouses)
                                                {
                                                    <option value="@wh.Id" selected="@(shelf.WarehouseId == wh.Id)">
                                                        @wh.Name (@wh.Code)
                                                    </option>
                                                }
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Mã kệ <span class="text-danger">*</span></label>
                                            <input class="form-control" name="Code" value="@shelf.Code" maxlength="50" required />
                                            <small class="text-muted">Mã kệ là duy nhất trong kho đã chọn.</small>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Tên kệ <span class="text-danger">*</span></label>
                                            <input class="form-control" name="Name" value="@shelf.Name" maxlength="150" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Mô tả</label>
                                            <textarea class="form-control" name="Description" rows="2" maxlength="500">@shelf.Description</textarea>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Trạng thái</label>
                                            <select class="form-select" name="Status">
                                                <option value="@Project.Models.ShelfStatus.Active" selected="@(shelf.Status == Project.Models.ShelfStatus.Active)">@Project.Models.ShelfStatus.Active</option>
                                                <option value="@Project.Models.ShelfStatus.Inactive" selected="@(shelf.Status == Project.Models.ShelfStatus.Inactive)">@Project.Models.ShelfStatus.Inactive</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
