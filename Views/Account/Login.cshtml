@model Project.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Đăng nhập hệ thống";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <title>@ViewData["Title"] - Thư viện</title>
    <partial name="_HeadAssets" />
</head>
<body class="login-page">
    <main class="login-wrap">
        <header class="login-brand">
            <span class="login-brand-pill"><span class="login-brand-icon">▤</span> HỆ THỐNG QUẢN LÝ THƯ VIỆN ĐIỆN TỬ</span>
            <div class="login-brand-sub">NỀN TẢNG ĐIỀU HÀNH VÀ QUẢN LÝ TÀI NGUYÊN SỐ</div>
        </header>

        <div class="login-grid">
            <section class="login-card">
                <div class="login-card-heading">
                    <div>
                        <h1>Đăng nhập hệ thống</h1>
                        <p>Cổng truy cập nghiệp vụ dành cho cán bộ thư viện.</p>
                    </div>
                    <span class="login-version"><i></i> BẢO MẬT</span>
                </div>

                <nav class="login-role-switch" aria-label="Chọn loại đăng nhập">
                    <a asp-controller="Librarian" asp-action="Login"><span>✓</span><span><strong>Thủ thư</strong><small>Duyệt hồ sơ bạn đọc</small></span></a>
                    <a class="selected" aria-current="page" asp-controller="Account" asp-action="Login"><span>⚙</span><span><strong>Quản trị viên</strong><small>Quản trị hệ thống</small></span></a>
                    <a asp-controller="ReaderRegistration" asp-action="Login"><span>♙</span><span><strong>Bạn đọc</strong><small>Đăng nhập thư viện</small></span></a>
                </nav>

                <div asp-validation-summary="ModelOnly" class="login-validation" role="alert"></div>
                <div id="authMessage" class="d-none" role="status" aria-live="polite"></div>

                <form asp-action="Login" method="post" id="loginForm" data-has-refresh="false" data-dashboard-url="@ViewData["DashboardUrl"]">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    <div class="login-field">
                        <div class="login-label-row"><label asp-for="Email">Email công vụ hoặc mã định danh</label><span>TÀI KHOẢN</span></div>
                        <div class="login-input-wrap"><span aria-hidden="true">✉</span><input asp-for="Email" class="form-control" placeholder="quantri@thuvien.edu.vn" autocomplete="username" autofocus /></div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="login-field">
                        <div class="login-label-row"><label asp-for="Password">Mật khẩu truy cập</label><span>BẢO MẬT</span></div>
                        <div class="login-input-wrap"><span aria-hidden="true">⚿</span><input asp-for="Password" class="form-control" placeholder="Nhập mật khẩu" autocomplete="current-password" /><button class="login-password-toggle" type="button" aria-label="Hiện mật khẩu" aria-pressed="false">◉</button></div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="login-options"><label><input type="checkbox" checked disabled /> Duy trì trạng thái đăng nhập</label><span>Phiên đăng nhập được bảo vệ</span></div>
                    <button type="submit" class="login-submit">Đăng nhập quản trị hệ thống <span aria-hidden="true">→</span></button>
                </form>

                <div class="login-help"><span class="login-help-icon">i</span><span>Chỉ tài khoản có vai trò Quản trị hệ thống mới đăng nhập tại đây.</span></div>
            </section>

            <aside class="login-aside">
                <section class="login-info-card">
                    <div class="login-aside-title"><span>▣</span><h2>Thư viện Trung tâm</h2></div>
                    <p>Nền tảng quản lý tập trung tài liệu, bạn đọc, kho sách và hoạt động nghiệp vụ thư viện.</p>
                    <div class="login-info-stats"><div><span>QUẢN LÝ TẬP TRUNG</span><strong>Tài liệu &amp; kho sách</strong></div><div><span>NGHIỆP VỤ THƯ VIỆN</span><strong>Phục vụ bạn đọc</strong></div></div>
                </section>

                <section class="login-security-card">
                    <div class="login-aside-title"><span>◈</span><h2>Bảo mật phiên làm việc</h2><span class="login-tag">AN TOÀN</span></div>
                    <p>Thông tin đăng nhập được bảo vệ trong suốt quá trình truy cập.</p>
                    <ul class="login-security-list">
                        <li><i class="secure-dot green"></i><div><strong>Mật khẩu được mã hóa</strong><small>Không lưu trữ mật khẩu dạng văn bản</small></div><b>›</b></li>
                        <li><i class="secure-dot blue"></i><div><strong>Phiên đăng nhập có thời hạn</strong><small>Tự động gia hạn khi phiên còn hợp lệ</small></div><b>›</b></li>
                        <li><i class="secure-dot slate"></i><div><strong>Truy cập nội bộ</strong><small>Dành cho nhân sự thư viện được cấp tài khoản</small></div><b>›</b></li>
                    </ul>
                    <div class="login-security-note">ⓘ Nếu gặp sự cố đăng nhập, vui lòng liên hệ quản trị hệ thống.</div>
                </section>
            </aside>
        </div>

        <footer class="login-footer"><span>© 2026 Thư viện · Hệ thống quản lý nội bộ</span><span>Hỗ trợ kỹ thuật: Quản trị hệ thống</span></footer>
    </main>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/auth-session.js" asp-append-version="true"></script>
    <script>
        document.querySelector('.login-password-toggle')?.addEventListener('click', event => {
            const button = event.currentTarget;
            const input = document.getElementById('Password');
            const reveal = input.type === 'password';
            input.type = reveal ? 'text' : 'password';
            button.setAttribute('aria-pressed', String(reveal));
            button.setAttribute('aria-label', reveal ? 'Ẩn mật khẩu' : 'Hiện mật khẩu');
        });
    </script>
</body>
</html>
