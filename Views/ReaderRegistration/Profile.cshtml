@model Project.Models.ReaderProfileViewModel
@{
    ViewData["Title"] = "Thông tin tài khoản Bạn đọc";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-9 col-lg-8">
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0 fs-5"><i class="bi bi-person-circle me-2"></i>Thông tin tài khoản Bạn đọc</h4>
            </div>
            <div class="card-body p-4">
                @if (TempData["HoldErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show mb-4" role="alert">
                        <strong><i class="bi bi-exclamation-triangle-fill me-2"></i>Không thể đặt giữ:</strong>
                        @TempData["HoldErrorMessage"]
                    </div>
                }

                @if (TempData["HoldSuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mb-4" role="alert">
                        <strong><i class="bi bi-check-circle-fill me-2"></i>Thành công:</strong>
                        @TempData["HoldSuccessMessage"]
                    </div>
                }

                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <label class="text-muted small">Họ và tên</label>
                        <div class="fw-bold fs-6">@Model.FullName</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small">Ngày sinh</label>
                        <div class="fw-bold fs-6">@Model.DateOfBirth.ToString("dd/MM/yyyy")</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small">Email</label>
                        <div class="fw-bold fs-6">@Model.Email</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small">Số điện thoại</label>
                        <div class="fw-bold fs-6">@Model.PhoneNumber</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small">Mã sinh viên / Mã cán bộ</label>
                        <div class="fw-bold fs-6">@Model.StudentOrStaffCode</div>
                    </div>
                    <div class="col-sm-6">
                        <label class="text-muted small">Trạng thái tài khoản</label>
                        <div id="accountStatusDisplay">
                            @if (string.Equals(Model.Status, "Chờ duyệt", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-warning text-dark px-3 py-2 fs-6">Chờ duyệt</span>
                            }
                            else if (string.Equals(Model.Status, "Từ chối", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="badge bg-danger px-3 py-2 fs-6">Từ chối</span>
                            }
                            else
                            {
                                <span class="badge bg-success px-3 py-2 fs-6">@Model.Status</span>
                            }
                        </div>
                    </div>
                </div>

                @if (string.Equals(Model.Status, "Chờ duyệt", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="alert alert-warning py-3 px-4 border-start border-4 border-warning mb-4" role="alert">
                        <h6 class="alert-heading fw-bold text-dark mb-2">Hướng dẫn kích hoạt tài khoản</h6>
                        <p class="mb-0 text-dark small">
                            Tài khoản của bạn hiện đang ở trạng thái <strong>Chờ duyệt</strong>. Vui lòng mang theo thẻ sinh viên / thẻ cán bộ hoặc giấy tờ tùy thân (CCCD) đến quầy thư viện để được nhân viên xác minh và duyệt kích hoạt tài khoản trước khi thực hiện đặt giữ tài liệu.
                        </p>
                    </div>
                }
                else if (string.Equals(Model.Status, "Từ chối", StringComparison.OrdinalIgnoreCase))
                {
                    <div class="alert alert-danger py-3 px-4 border-start border-4 border-danger mb-4" role="alert">
                        <h6 class="alert-heading fw-bold mb-2">Hồ sơ của bạn đã bị từ chối.</h6>
                        <p class="mb-0"><strong>Lý do từ chối:</strong> @Model.RejectionReason</p>
                    </div>
                }
                else if (Model.LibraryCard != null)
                {
                    <div class="alert alert-success mb-4">
                        <strong>Thẻ thư viện:</strong> @Model.LibraryCard.CardCode
                        <span class="mx-1">·</span>@Model.LibraryCard.LibraryCardType?.Name
                        <span class="mx-1">·</span>Hết hạn @Model.LibraryCard.ExpiresOn.ToString("dd/MM/yyyy")
                    </div>
                }

                @if (TempData["ProfileSuccessMessage"] != null)
                {
                    <div class="alert alert-success" role="status">@TempData["ProfileSuccessMessage"]</div>
                }

                <form asp-action="Profile" method="post" class="mb-4" id="profileForm">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label class="form-label">H? v� t�n</label>
                            <input class="form-control" value="@Model.FullName" readonly />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">Ng�y sinh</label>
                            <input class="form-control" value="@Model.DateOfBirth.ToString("dd/MM/yyyy")" readonly />
                        </div>
                        <div class="col-sm-6">
                            <label class="form-label">M� th?</label>
                            <input class="form-control" value="@Model.CardCode" readonly />
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Address" class="form-label"></label>
                            <input asp-for="Address" class="form-control" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                        <div class="col-12">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" type="email" pattern="[^@@\s]+@@[^@@\s]+\.[^@@\s]+" class="form-control" data-initial-email="@Model.Email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                        <div class="col-12" id="currentPasswordContainer" hidden>
                            <label asp-for="CurrentPassword" class="form-label">Mật khẩu hiện tại</label>
                            <input asp-for="CurrentPassword" type="password" class="form-control" autocomplete="current-password" />
                            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary mt-3">L?u thay d?i</button>
                </form>

                @if (Model.CardCode != null)
                {
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6"><label class="text-muted small">Card type</label><div class="fw-bold">@Model.CardType</div></div>
                        <div class="col-sm-6"><label class="text-muted small">Card expiry</label><div class="fw-bold">@Model.CardExpiresOn?.ToString("dd/MM/yyyy")</div></div>
                        <div class="col-sm-6"><label class="text-muted small">Card status</label><div class="fw-bold">@Model.CardStatus</div></div>
                    </div>
                }

                <div class="card card-body bg-light mb-4">
                    <h5 class="fw-bold mb-3">Đổi mật khẩu</h5>
                    @if (TempData["PasswordSuccessMessage"] != null)
                    {
                        <div class="alert alert-success" role="status">@TempData["PasswordSuccessMessage"]</div>
                    }
                    @if (TempData["PasswordErrorMessage"] != null)
                    {
                        <div class="alert alert-danger" role="alert">@TempData["PasswordErrorMessage"]</div>
                    }
                    <form asp-action="ChangePassword" method="post" id="changePasswordForm">
                        <div class="mb-3">
                            <label for="changeCurrentPassword" class="form-label">Mật khẩu cũ</label>
                            <input type="password" id="changeCurrentPassword" name="CurrentPassword" class="form-control" autocomplete="current-password" required />
                        </div>
                        <div class="mb-3">
                            <label for="newPassword" class="form-label">Mật khẩu mới</label>
                            <input type="password" id="newPassword" name="NewPassword" class="form-control" autocomplete="new-password" required />
                        </div>
                        <div class="mb-3">
                            <label for="confirmNewPassword" class="form-label">Nhập lại mật khẩu mới</label>
                            <input type="password" id="confirmNewPassword" name="ConfirmNewPassword" class="form-control" autocomplete="new-password" required />
                        </div>
                        <button type="submit" class="btn btn-outline-primary">Đổi mật khẩu</button>
                    </form>
                </div>

                <hr class="my-4">

                <h5 class="fw-bold mb-3 text-secondary">Chức năng: Đặt giữ tài liệu</h5>
                @if (string.Equals(Model.Status, "Đang hoạt động", StringComparison.OrdinalIgnoreCase))
                {
                    <form asp-action="HoldDocument" method="post" class="card card-body bg-light border-0">
                        <div class="row g-2 align-items-center">
                            <div class="col-auto"><label for="documentId" class="col-form-label fw-semibold">Mã tài liệu:</label></div>
                            <div class="col-auto"><input type="number" id="documentId" name="documentId" class="form-control" value="101" required /></div>
                            <div class="col-auto"><button type="submit" class="btn btn-primary" id="btnHoldDocument">Đặt giữ tài liệu</button></div>
                        </div>
                    </form>
                }
                else
                {
                    <p class="text-muted mb-0">Chỉ tài khoản đang hoạt động mới có thể đặt giữ tài liệu.</p>
                }

                <div class="mt-4 pt-3 border-top text-end">
                    <form asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-outline-danger btn-sm">Đăng xuất</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.getElementById("profileForm");
            const email = document.getElementById("Email");
            const password = document.getElementById("CurrentPassword");
            const passwordContainer = document.getElementById("currentPasswordContainer");
            if (!form || !email || !password || !passwordContainer) return;

            const originalEmail = (email.dataset.initialEmail || "").trim().toLowerCase();
            const emailChanged = () => email.value.trim().toLowerCase() !== originalEmail;
            const updatePasswordVisibility = () => {
                passwordContainer.hidden = !emailChanged();
            };

            email.addEventListener("input", updatePasswordVisibility);
            updatePasswordVisibility();
            form.addEventListener("submit", event => {
                if (emailChanged() && !password.value.trim()) {
                    event.preventDefault();
                    passwordContainer.hidden = false;
                    password.setCustomValidity("Vui lòng nhập mật khẩu hiện tại.");
                    password.reportValidity();
                } else {
                    password.setCustomValidity("");
                }
            });
            password.addEventListener("input", () => password.setCustomValidity(""));
        })();
    </script>
    <script>
        (() => {
            const form = document.getElementById("changePasswordForm");
            const newPassword = document.getElementById("newPassword");
            const confirmation = document.getElementById("confirmNewPassword");
            if (!form || !newPassword || !confirmation) return;

            const validateConfirmation = () => {
                confirmation.setCustomValidity(
                    confirmation.value && confirmation.value !== newPassword.value
                        ? "Mật khẩu mới và mật khẩu xác nhận không trùng khớp."
                        : "");
            };
            newPassword.addEventListener("input", validateConfirmation);
            confirmation.addEventListener("input", validateConfirmation);
            form.addEventListener("submit", event => {
                validateConfirmation();
                if (!form.reportValidity()) event.preventDefault();
            });
        })();
    </script>
}
