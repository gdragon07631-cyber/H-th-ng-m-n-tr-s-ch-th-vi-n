@model Project.Models.ReaderRegistrationViewModel
@{
    ViewData["Title"] = "Đăng ký tài khoản Bạn đọc";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3 mb-3 text-center text-primary font-weight-bold">Đăng ký tài khoản Bạn đọc</h1>
                <p class="text-muted text-center mb-4">Điền đầy đủ các thông tin dưới đây để đăng ký tài khoản thư viện</p>

                <form asp-action="Register" method="post" id="readerRegisterForm" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold">Họ và tên <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" placeholder="Nguyễn Văn A" autofocus />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DateOfBirth" class="form-label fw-semibold">Ngày sinh <span class="text-danger">*</span></label>
                        <input asp-for="DateOfBirth" type="date" class="form-control" max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold">Email <span class="text-danger">*</span></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="bandoc@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                        @if (ViewBag.ShowForgotPasswordSuggestion == true)
                        {
                            <div class="alert alert-info mt-2 py-2 px-3 small border-0 bg-info-subtle text-info-emphasis" role="alert">
                                <strong>Gợi ý:</strong> Nếu đây là tài khoản của bạn, hãy sử dụng chức năng <a asp-action="ForgotPassword" class="alert-link">Quên mật khẩu</a>.
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                        <input asp-for="PhoneNumber" type="tel" inputmode="numeric" class="form-control" placeholder="0901234567" />
                        <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="StudentOrStaffCode" class="form-label fw-semibold">Mã sinh viên hoặc mã cán bộ <span class="text-danger">*</span></label>
                        <input asp-for="StudentOrStaffCode" class="form-control" placeholder="SV2026001 hoặc CB001" />
                        <span asp-validation-for="StudentOrStaffCode" class="text-danger small"></span>
                        @if (ViewBag.ShowCodeForgotPasswordSuggestion == true)
                        {
                            <div class="alert alert-info mt-2 py-2 px-3 small border-0 bg-info-subtle text-info-emphasis" role="alert">
                                <strong>Gợi ý:</strong> Nếu đây là tài khoản của bạn, hãy sử dụng chức năng <a asp-action="ForgotPassword" class="alert-link">Quên mật khẩu</a>.
                            </div>
                        }
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">Mật khẩu <span class="text-danger">*</span></label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Tối thiểu 8 ký tự, gồm cả chữ và số" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold">Nhập lại mật khẩu <span class="text-danger">*</span></label>
                        <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu phía trên" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 fs-5">Đăng ký tài khoản</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/reader-registration.js" asp-append-version="true"></script>
}
