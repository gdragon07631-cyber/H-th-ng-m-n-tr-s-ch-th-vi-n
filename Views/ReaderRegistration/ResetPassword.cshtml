@model Project.Models.ResetPasswordViewModel
@{
    Layout = "_ReaderLayout";
    ViewData["Title"] = "Tạo mật khẩu mới";
}
<div class="row justify-content-center py-5"><div class="col-12 col-md-7 col-lg-5"><div class="card shadow-sm border-0"><div class="card-body p-4 p-md-5">
    <h1 class="h3 mb-4 text-center text-primary fw-bold">Tạo mật khẩu mới</h1>
    @if (ViewBag.Success is string success) { <div class="alert alert-success" role="status">@success <a asp-action="Login">Đăng nhập</a></div> }
    else if (ViewBag.InvalidToken == true) { <div class="alert alert-danger" role="alert">Liên kết không hợp lệ, đã hết hạn hoặc đã được sử dụng. Vui lòng yêu cầu liên kết mới.</div> }
    else {
        <form asp-action="ResetPassword" method="post">
            <input asp-for="Token" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3"><label asp-for="Password" class="form-label fw-semibold"></label><input asp-for="Password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
            <div class="mb-3"><label asp-for="ConfirmPassword" class="form-label fw-semibold"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div>
            <button type="submit" class="btn btn-primary w-100">Đổi mật khẩu</button>
        </form>
    }
</div></div></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
