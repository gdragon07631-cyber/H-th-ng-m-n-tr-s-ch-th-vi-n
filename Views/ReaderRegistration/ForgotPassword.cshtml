@model Project.Models.ForgotPasswordViewModel
@{
    Layout = "_ReaderLayout";
    ViewData["Title"] = "Quên mật khẩu";
}
<div class="rd-narrow">
    <div class="rd-card">
        <div class="rd-card-body">
            <div class="rd-status">
                <div class="rd-status-icon is-gold"><i class="bi bi-key"></i></div>
                <h1>Quên mật khẩu?</h1>
                <p class="rd-lead">Nhập email bạn đã đăng ký, chúng tôi sẽ gửi liên kết để bạn tạo mật khẩu mới.</p>
            </div>
            @if (ViewBag.Message is string message) { <div class="alert alert-info" role="status"><i class="bi bi-envelope-paper me-1"></i> @message</div> }
            <form asp-action="ForgotPassword" method="post" class="rd-form">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <div class="login-input-group">
                        <i class="bi bi-envelope login-input-icon" aria-hidden="true"></i>
                        <input asp-for="Email" class="form-control" placeholder="bandoc@example.com" autocomplete="email" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <button type="submit" class="login-submit"><span>Gửi liên kết đặt lại mật khẩu</span><i class="bi bi-send ms-1"></i></button>
            </form>
            <p class="text-center small mt-3 mb-0"><a asp-action="Login"><i class="bi bi-arrow-left me-1"></i>Quay lại đăng nhập</a></p>
        </div>
    </div>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
