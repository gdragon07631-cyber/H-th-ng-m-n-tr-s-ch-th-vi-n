@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3 mb-3 text-primary">Quên mật khẩu</h1>
                <p>Chức năng khôi phục mật khẩu trực tuyến hiện chưa được triển khai.</p>
                <p>Vui lòng liên hệ nhân viên tại quầy thư viện để được hướng dẫn hỗ trợ tài khoản đã đăng ký.</p>
                <a asp-action="Login" class="btn btn-outline-primary">Đăng nhập bạn đọc</a>
                <a asp-action="Register" class="btn btn-link">Về trang đăng ký</a>
            </div>
        </div>
    </div>
</div>
