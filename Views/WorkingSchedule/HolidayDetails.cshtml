@model Project.Models.HolidayClosure
@{
    ViewData["Title"] = "Chi tiết ngày nghỉ";
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-primary fw-bold">Chi tiết ngày nghỉ</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại lịch làm việc</a>
    </div>
    <div class="card shadow-sm border-0"><div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Ngày</dt><dd class="col-sm-9">@Model.HolidayDate.ToString("dd/MM/yyyy")</dd>
            <dt class="col-sm-3">Tên / lý do nghỉ</dt><dd class="col-sm-9">@Model.Reason</dd>
            <dt class="col-sm-3">Trạng thái</dt><dd class="col-sm-9"><span class="badge bg-secondary">Đóng cửa</span></dd>
            <dt class="col-sm-3">Ghi chú</dt><dd class="col-sm-9">@(Model.Note ?? "—")</dd>
        </dl>
    </div></div>
</div>
