@model Project.Models.BookCopyIndexViewModel
@using Project.Models
@{
    ViewData["Title"] = "Bản sao – " + Model.BookTitle;
    string StatusBadge(string status) => status switch
    {
        BookCopyStatus.Available => "bg-success-subtle text-success-emphasis",
        BookCopyStatus.UnderRepair => "bg-warning-subtle text-warning-emphasis",
        BookCopyStatus.OnLoan => "bg-primary-subtle text-primary-emphasis",
        _ => "bg-secondary-subtle text-secondary-emphasis"
    };
}
<div class="container py-4">
    <div class="mb-4">
        <a asp-controller="Book" asp-action="Details" asp-route-id="@Model.BookId" class="small text-decoration-none">← @Model.BookTitle</a>
        <h1 class="h3 mt-2 mb-1 text-primary fw-bold">Bản sao của đầu sách</h1>
        <p class="text-muted mb-0">Cập nhật kho, kệ, tình trạng vật lý và trạng thái để sổ sách khớp với vị trí thật của sách.</p>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }
    @if (Model.BatchSuccessMessage is string batchSuccess)
    {
        <div class="alert alert-success" role="status">@batchSuccess</div>
    }

    <div class="card shadow-sm border-0 mb-4" style="max-width: 52rem">
        <div class="card-header"><h2 class="h5 mb-0">Tạo lô bản sao</h2></div>
        <div class="card-body">
            <form asp-action="CreateBatch" asp-route-bookId="@Model.BookId" method="post" class="row g-3 align-items-end">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="col-md-3">
                    <label asp-for="Batch.Quantity" class="form-label"></label>
                    <input asp-for="Batch.Quantity" type="number" min="1" max="50" step="1" class="form-control" />
                    <span asp-validation-for="Batch.Quantity" class="text-danger"></span>
                    <div class="form-text mt-2">Khoảng mã vạch dự kiến: <span id="barcode-preview" data-preview-url="@Url.Action("PreviewBatch", "BookCopy")" aria-live="polite">Chưa có</span></div>
                    <span id="barcode-preview-error" class="text-danger" role="alert"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Batch.WarehouseId" class="form-label"></label>
                    <select asp-for="Batch.WarehouseId" class="form-select" required>
                        <option value="">-- Chọn kho --</option>
                        @foreach (var warehouse in Model.Warehouses)
                        {
                            <option value="@warehouse.Id">@warehouse.Code – @warehouse.Name</option>
                        }
                    </select>
                    <span asp-validation-for="Batch.WarehouseId" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Batch.ShelfId" class="form-label"></label>
                    <select asp-for="Batch.ShelfId" class="form-select" required>
                        <option value="">-- Chọn kệ --</option>
                        @foreach (var shelf in Model.Shelves)
                        {
                            <option value="@shelf.Id" data-warehouse-id="@shelf.WarehouseId">@shelf.Code – @shelf.Name</option>
                        }
                    </select>
                    <span asp-validation-for="Batch.ShelfId" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Batch.ReceivedDate" class="form-label"></label>
                    <input asp-for="Batch.ReceivedDate" type="date" class="form-control" required />
                    <span asp-validation-for="Batch.ReceivedDate" class="text-danger"></span>
                </div>
                <div class="col-12 d-grid d-md-flex justify-content-md-end">
                    <button type="submit" class="btn btn-primary">Lưu</button>
                </div>
            </form>
        </div>
    </div>

    @if (Model.CreatedCopies.Count > 0)
    {
        <section class="mb-4" aria-labelledby="created-copies-heading">
            <h2 id="created-copies-heading" class="h5">Danh sách bản sao vừa tạo</h2>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light"><tr><th>STT</th><th>Mã vạch</th><th>Kho</th><th>Kệ</th><th>Ngày nhập</th></tr></thead>
                    <tbody>
                        @for (var index = 0; index < Model.CreatedCopies.Count; index++)
                        {
                            var copy = Model.CreatedCopies[index];
                            <tr>
                                <td>@(index + 1)</td>
                                <td class="font-monospace">@copy.CopyCode</td>
                                <td>@copy.Shelf?.Warehouse?.Code</td>
                                <td>@copy.Shelf?.Code</td>
                                <td>@copy.ReceivedDate?.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <form asp-action="PrintLabels" method="get" target="_blank" class="mt-3">
                <input type="hidden" name="bookId" value="@Model.BookId" />
                @foreach (var copy in Model.CreatedCopies)
                {
                    <input type="hidden" name="copyIds" value="@copy.Id" />
                }
                <button type="submit" class="btn btn-outline-primary">In nhãn mã vạch</button>
            </form>
        </section>
    }
    @if (Model.SkippedBarcodes.Count > 0)
    {
        <div class="alert alert-warning" role="status">
            Đã bỏ qua mã bị trùng: @string.Join(", ", Model.SkippedBarcodes)
        </div>
    }

    <div class="card shadow-sm border-0 mb-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr><th>Mã vạch</th><th>Kho</th><th>Kệ</th><th>Tình trạng vật lý</th><th>Trạng thái</th><th>Ghi chú</th><th class="text-end">Thao tác</th></tr>
                </thead>
                <tbody>
                    @if (Model.Copies.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Đầu sách này chưa có bản sao nào.</td></tr>
                    }
                    @foreach (var copy in Model.Copies)
                    {
                        <tr>
                            <td class="fw-semibold font-monospace">@copy.CopyCode</td>
                            <td>@copy.Shelf?.Warehouse?.Name</td>
                            <td>@copy.Shelf?.Code – @copy.Shelf?.Name</td>
                            <td>@copy.PhysicalCondition</td>
                            <td><span class="badge @StatusBadge(copy.Status)">@copy.Status</span></td>
                            <td class="small text-muted">@(copy.Note ?? "—")</td>
                            <td class="text-end"><a asp-action="Edit" asp-route-id="@copy.Id" class="btn btn-sm btn-outline-primary">Sửa</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="card shadow-sm border-0" style="max-width: 52rem">
        <div class="card-header"><h2 class="h5 mb-0">Thêm bản sao</h2></div>
        <div class="card-body">
            @if (Model.Shelves.Count == 0)
            {
                <p class="text-muted mb-0">Chưa có kệ nào đang hoạt động. Hãy tạo kho và kệ trước khi thêm bản sao.</p>
            }
            else
            {
                <form asp-action="Create" asp-route-bookId="@Model.BookId" method="post" class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label asp-for="NewCopy.CopyCode" class="form-label"></label>
                        <input asp-for="NewCopy.CopyCode" class="form-control" placeholder="VD: 893000123" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="NewCopy.ShelfId" class="form-label"></label>
                        <select asp-for="NewCopy.ShelfId" class="form-select" required>
                            <option value="">-- Chọn kệ --</option>
                            @foreach (var shelf in Model.Shelves)
                            {
                                <option value="@shelf.Id">@shelf.Warehouse?.Name / @shelf.Code – @shelf.Name</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="NewCopy.PhysicalCondition" class="form-label"></label>
                        <select asp-for="NewCopy.PhysicalCondition" class="form-select" asp-items="@(new SelectList(BookCopyCondition.All))"></select>
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="submit" class="btn btn-primary">Thêm</button>
                    </div>
                </form>
            }
        </div>
    </div>
</div>
<script>
    (() => {
        const quantity = document.getElementById('Batch_Quantity');
        const preview = document.getElementById('barcode-preview');
        const previewError = document.getElementById('barcode-preview-error');
        let previewRequest;
        if (quantity && preview && previewError) {
            quantity.addEventListener('input', async () => {
                previewRequest?.abort();
                previewRequest = null;
                preview.textContent = 'Chưa có';
                previewError.textContent = '';

                if (quantity.value === '') return;
                const amount = Number(quantity.value);
                if (!Number.isInteger(amount) || amount < 1 || amount > 50) {
                    previewError.textContent = 'Số lượng phải là số nguyên từ 1 đến 50.';
                    return;
                }

                const request = new AbortController();
                previewRequest = request;
                try {
                    const url = new URL(preview.dataset.previewUrl, window.location.href);
                    url.searchParams.set('quantity', amount.toString());
                    const response = await fetch(url, { signal: request.signal, headers: { Accept: 'application/json' } });
                    const result = await response.json();
                    if (!response.ok || !result.isSuccess) {
                        previewError.textContent = result.errorMessage || 'Không thể tính khoảng mã vạch.';
                        return;
                    }
                    preview.textContent = result.displayRange;
                } catch (error) {
                    if (error.name !== 'AbortError') previewError.textContent = 'Không thể tính khoảng mã vạch.';
                }
            });
        }

        const warehouse = document.getElementById('Batch_WarehouseId');
        const shelf = document.getElementById('Batch_ShelfId');
        if (!warehouse || !shelf) return;
        const filterShelves = () => {
            const warehouseId = warehouse.value;
            for (const option of shelf.options) {
                if (!option.value) continue;
                option.hidden = option.dataset.warehouseId !== warehouseId;
                if (option.hidden && option.selected) shelf.value = '';
            }
        };
        warehouse.addEventListener('change', filterShelves);
        filterShelves();
    })();
</script>
