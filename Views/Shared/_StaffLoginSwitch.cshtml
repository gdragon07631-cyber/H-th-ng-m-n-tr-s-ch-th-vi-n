@model string
@* Thanh chuyển đổi vai trò đăng nhập *@
@{
    var options = new[]
    {
        new { Controller = "Account", Icon = "bi-shield-lock", Name = "Quản trị" },
        new { Controller = "Manager", Icon = "bi-briefcase", Name = "Quản lý" },
        new { Controller = "Librarian", Icon = "bi-person-badge", Name = "Thủ thư" },
        new { Controller = "ReaderRegistration", Icon = "bi-book", Name = "Bạn đọc" },
    };
}
<nav class="login-role-tabs" aria-label="Chọn cổng đăng nhập">
    @foreach (var option in options)
    {
        var isSelected = string.Equals(option.Controller, Model, StringComparison.OrdinalIgnoreCase);
        <a class="login-role-tab @(isSelected ? "active" : "")" 
           aria-current="@(isSelected ? "page" : null)" 
           asp-controller="@option.Controller" 
           asp-action="Login">
            <i class="bi @option.Icon" aria-hidden="true"></i>
            <span>@option.Name</span>
        </a>
    }
</nav>
