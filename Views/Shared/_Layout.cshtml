<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Thư viện</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Project.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">T</span>
                <span><strong>THƯ VIỆN</strong><small>QUẢN LÝ THƯ VIỆN</small></span>
            </a>
            <div class="side-label">TỔNG QUAN</div>
            <a class="side-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index"><span>⌂</span> Dashboard</a>
            <div class="side-label">QUẢN LÝ</div>
            <a class="side-link" asp-controller="Book" asp-action="Index"><span>▤</span> Sách</a>
            <a class="side-link" asp-controller="Author" asp-action="Index"><span>♙</span> Tác giả</a>
            <a class="side-link" asp-controller="Category" asp-action="Index"><span>▦</span> Thể loại</a>
            <a class="side-link" asp-controller="Warehouse" asp-action="Index"><span>▣</span> Kho sách</a>
            <a class="side-link" asp-controller="Shelf" asp-action="Index"><span>▥</span> Kệ sách</a>
            <a class="side-link" asp-controller="Loan" asp-action="Index"><span>⇄</span> Mượn trả</a>
            <a class="side-link" asp-controller="WorkingSchedule" asp-action="Index"><span>◷</span> Lịch làm việc</a>
            <div class="side-label">BẠN ĐỌC</div>
            <a class="side-link" asp-controller="ReaderApproval" asp-action="Index"><span>✓</span> Hồ sơ chờ duyệt</a>
            <a class="side-link" asp-controller="ReaderRegistration" asp-action="Register"><span>＋</span> Đăng ký bạn đọc</a>
            <div class="sidebar-bottom"><span class="status-dot"></span> Hệ thống thư viện</div>
        </aside>

        <div class="main-shell">
            <header class="topbar">
                <div class="breadcrumb">Thư viện <span>/</span> @ViewData["Title"]</div>
                <a class="admin-link" asp-controller="Account" asp-action="Login"><span class="admin-avatar">Q</span> Quản trị viên <span class="caret">⌄</span></a>
            </header>
            <main class="page-content" role="main">@RenderBody()</main>
            <footer class="page-footer">© 2026 Thư viện · Hệ thống quản lý nội bộ</footer>
        </div>
    </div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
