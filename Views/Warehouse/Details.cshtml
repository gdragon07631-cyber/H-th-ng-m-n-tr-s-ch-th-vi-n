@model Project.Models.WarehouseDetailsViewModel
@{
    ViewData["Title"] = $"Chi tiết kho: {Model.Warehouse.Name}";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Index">Danh sách kho</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@Model.Warehouse.Code</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0 text-primary fw-bold">Kho: @Model.Warehouse.Name</h1>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i> Quay lại danh sách kho
            </a>
        </div>
    </div>

    <!-- Thông báo lỗi / thành công -->
    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Thành công!</strong> @success
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is string error)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Lỗi:</strong> @error
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Thông tin tổng quan kho -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
            <h2 class="h5 mb-0 fw-semibold text-dark">Thông tin Kho lưu trữ</h2>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3 mb-2">
                    <div class="text-muted small">Mã kho</div>
                    <div class="fs-5 fw-bold font-monospace text-primary">@Model.Warehouse.Code</div>
                </div>
                <div class="col-md-4 mb-2">
                    <div class="text-muted small">Tên kho</div>
                    <div class="fs-6 fw-semibold">@Model.Warehouse.Name</div>
                </div>
                <div class="col-md-3 mb-2">
                    <div class="text-muted small">Trạng thái</div>
                    <div>
                        <span class="badge @(Model.Warehouse.Status == Project.Models.WarehouseStatus.Active ? "bg-success" : "bg-secondary") fs-6">
                            @Model.Warehouse.Status
                        </span>
                    </div>
                </div>
                <div class="col-md-2 mb-2">
                    <div class="text-muted small">Tổng số kệ</div>
                    <div class="fs-5 fw-bold text-info">@Model.Shelves.Count kệ</div>
                </div>
            </div>
            <div class="row mt-2 pt-2 border-top">
                <div class="col-md-6 mb-2">
                    <div class="text-muted small">Địa chỉ / Vị trí</div>
                    <div>@(Model.Warehouse.Address ?? "Chưa thiết lập")</div>
                </div>
                <div class="col-md-6 mb-2">
                    <div class="text-muted small">Mô tả</div>
                    <div>@(Model.Warehouse.Description ?? "Không có mô tả")</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Form Thêm Kệ Thuộc Kho Này -->
    <div class="card shadow-sm border-0 mb-4 border-start border-4 border-primary">
        <div class="card-header bg-white py-3">
            <h2 class="h5 mb-0 fw-semibold text-primary">
                Khai báo Kệ mới thuộc kho "@Model.Warehouse.Name"
            </h2>
        </div>
        <div class="card-body">
            <form asp-action="CreateShelf" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <input type="hidden" name="WarehouseId" value="@Model.Warehouse.Id" />
                
                <div class="col-md-3">
                    <label class="form-label fw-bold" for="ShelfCode">Mã kệ <span class="text-danger">*</span></label>
                    <input class="form-control" id="ShelfCode" name="Code" placeholder="VD: KE-01, K1-A" maxlength="50" required />
                    <small class="text-muted">Duy nhất trong kho <strong>@Model.Warehouse.Code</strong></small>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold" for="ShelfName">Tên kệ <span class="text-danger">*</span></label>
                    <input class="form-control" id="ShelfName" name="Name" placeholder="VD: Kệ Giáo trình Khoa học máy tính" maxlength="150" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="ShelfDescription">Mô tả kệ</label>
                    <input class="form-control" id="ShelfDescription" name="Description" placeholder="VD: Hàng 1, ngăn A..." maxlength="500" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100" type="submit">
                        <i class="bi bi-plus-circle"></i> Thêm kệ
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Danh sách Kệ Thuộc Kho -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0 fw-semibold">Danh sách Kệ sách trong kho</h2>
            <span class="badge bg-secondary rounded-pill fs-6">@Model.Shelves.Count kệ</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 140px;">Mã kệ</th>
                        <th>Tên kệ</th>
                        <th>Mô tả</th>
                        <th style="width: 130px;" class="text-center">Trạng thái</th>
                        <th style="width: 200px;" class="text-end pe-3">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Shelves.Count == 0)
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">Kho này chưa có kệ sách nào. Hãy thêm kệ ở form phía trên.</td>
                    </tr>
                }
                @foreach (var shelf in Model.Shelves)
                {
                    <tr>
                        <td>
                            <span class="badge bg-primary font-monospace fs-6">@shelf.Code</span>
                        </td>
                        <td class="fw-bold">
                            @shelf.Name
                        </td>
                        <td>
                            @(shelf.Description ?? "—")
                        </td>
                        <td class="text-center">
                            <span class="badge @(shelf.Status == Project.Models.ShelfStatus.Active ? "bg-success" : "bg-secondary")">
                                @shelf.Status
                            </span>
                        </td>
                        <td class="text-end pe-3 text-nowrap">
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editShelfModal-@shelf.Id">
                                Sửa
                            </button>

                            <form asp-action="DeleteShelf" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa kệ sách \'@shelf.Name\' (Mã: @shelf.Code)?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@shelf.Id" />
                                <input type="hidden" name="warehouseId" value="@Model.Warehouse.Id" />
                                <button class="btn btn-sm btn-outline-danger" type="submit">
                                    Xóa
                                </button>
                            </form>
                        </td>
                    </tr>

                    <!-- Modal Sửa Kệ -->
                    <div class="modal fade" id="editShelfModal-@shelf.Id" tabindex="-1" aria-labelledby="editShelfLabel-@shelf.Id" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <form asp-action="EditShelf" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Id" value="@shelf.Id" />
                                    <input type="hidden" name="WarehouseId" value="@Model.Warehouse.Id" />
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="editShelfLabel-@shelf.Id">Sửa thông tin Kệ sách</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body text-start">
                                        <div class="mb-3">
                                            <label class="form-label text-muted">Kho trực thuộc</label>
                                            <input class="form-control" value="@Model.Warehouse.Name (@Model.Warehouse.Code)" disabled readonly />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Mã kệ <span class="text-danger">*</span></label>
                                            <input class="form-control" name="Code" value="@shelf.Code" maxlength="50" required />
                                            <small class="text-muted">Mã kệ không được trùng với kệ khác trong cùng kho @Model.Warehouse.Code.</small>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Tên kệ <span class="text-danger">*</span></label>
                                            <input class="form-control" name="Name" value="@shelf.Name" maxlength="150" required />
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Mô tả</label>
                                            <textarea class="form-control" name="Description" rows="2" maxlength="500">@shelf.Description</textarea>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label">Trạng thái</label>
                                            <select class="form-select" name="Status">
                                                <option value="@Project.Models.ShelfStatus.Active" selected="@(shelf.Status == Project.Models.ShelfStatus.Active)">@Project.Models.ShelfStatus.Active</option>
                                                <option value="@Project.Models.ShelfStatus.Inactive" selected="@(shelf.Status == Project.Models.ShelfStatus.Inactive)">@Project.Models.ShelfStatus.Inactive</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                                        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
