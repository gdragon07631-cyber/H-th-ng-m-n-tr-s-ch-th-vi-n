{
    "version": "0.2.0",
    "configurations": [
        {
            // Build, chạy app rồi tự mở Chrome khi server sẵn sàng.
            "name": "Chạy app và mở Chrome",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/bin/Debug/net10.0/Project.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5188"
            },
            "serverReadyAction": {
                "action": "debugWithChrome",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s",
                "webRoot": "${workspaceFolder}/wwwroot",
                "killOnServerStop": true
            }
        },
        {
            // Chỉ mở Chrome; app phải đang chạy sẵn (ví dụ bằng `dotnet run`).
            "name": "Mở Chrome (app đang chạy)",
            "type": "chrome",
            "request": "launch",
            "url": "http://localhost:5188",
            "webRoot": "${workspaceFolder}/wwwroot"
        }
    ]
}
